{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-software-factory/schemas/project.schema.json",
  "title": "Project Manifest",
  "description": "Machine-readable description of a project generated by the factory. Lives at .project/project.json and is authoritative for project type, capabilities, stack, agent roster and lifecycle position.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "name", "slug", "projectType", "platforms",
    "capabilities", "stack", "selectedAgents", "generatedDocuments",
    "currentPhase", "status", "createdAt", "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "name": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "description": { "type": "string" },
    "projectType": {
      "type": "string",
      "enum": [
        "web-only", "web-backend", "web-backend-database",
        "mobile-only", "mobile-backend", "web-mobile-backend",
        "api-only", "admin-portal", "desktop", "library", "cli", "other"
      ]
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["web", "admin-portal", "ios", "android", "backend", "desktop", "cli"]
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["web", "mobile", "backend", "database", "auth", "browserTesting"],
      "properties": {
        "web": { "type": "boolean" },
        "adminPortal": { "type": "boolean", "default": false },
        "mobile": { "type": "boolean" },
        "desktop": { "type": "boolean", "default": false },
        "backend": { "type": "boolean" },
        "api": { "type": "boolean", "default": false },
        "database": { "type": "boolean" },
        "auth": { "type": "boolean" },
        "authzRoles": { "type": "boolean", "default": false },
        "offline": { "type": "boolean", "default": false },
        "realtime": { "type": "boolean", "default": false },
        "fileUpload": { "type": "boolean", "default": false },
        "notifications": { "type": "boolean", "default": false },
        "backgroundJobs": { "type": "boolean", "default": false },
        "reporting": { "type": "boolean", "default": false },
        "payments": { "type": "boolean", "default": false },
        "i18n": { "type": "boolean", "default": false },
        "multiTenant": { "type": "boolean", "default": false },
        "responsive": { "type": "boolean", "default": false },
        "browserTesting": { "type": "boolean" },
        "integration": { "type": "boolean", "default": false },
        "deployable": { "type": "boolean", "default": true },
        "existingCodebase": { "type": "boolean", "default": false }
      }
    },
    "stack": {
      "type": "object",
      "description": "Chosen technologies. Omit an area entirely when it does not apply.",
      "additionalProperties": false,
      "properties": {
        "web": { "$ref": "#/definitions/stackArea" },
        "adminPortal": { "$ref": "#/definitions/stackArea" },
        "mobile": { "$ref": "#/definitions/stackArea" },
        "desktop": { "$ref": "#/definitions/stackArea" },
        "backend": { "$ref": "#/definitions/stackArea" },
        "database": { "$ref": "#/definitions/stackArea" },
        "infrastructure": { "$ref": "#/definitions/stackArea" },
        "testing": { "$ref": "#/definitions/stackArea" }
      }
    },
    "commands": {
      "type": "object",
      "description": "Resolved project commands, substituted into generated agents.",
      "additionalProperties": { "type": "string" },
      "properties": {
        "install": { "type": "string" },
        "dev": { "type": "string" },
        "build": { "type": "string" },
        "test": { "type": "string" },
        "lint": { "type": "string" },
        "typecheck": { "type": "string" },
        "migrate": { "type": "string" },
        "start": { "type": "string" }
      }
    },
    "paths": {
      "type": "object",
      "description": "Source roots per area, relative to the repository root.",
      "additionalProperties": { "type": "string" }
    },
    "appUrl": { "type": "string", "description": "Local dev URL for browser testing, e.g. http://localhost:3000" },
    "breakpoints": {
      "type": "array",
      "description": "Viewport classes. `width`/`height` are the portrait dimensions actually tested; landscape is the transpose unless `orientations` excludes it. See factory/rules/responsive-rules.md §2.",
      "items": {
        "type": "object",
        "required": ["name", "width"],
        "properties": {
          "name": { "type": "string" },
          "width": { "type": "integer" },
          "height": { "type": "integer" },
          "touch": { "type": "boolean", "default": false }
        }
      }
    },
    "orientations": {
      "type": "array",
      "description": "Orientations supported and tested across every screen. Both unless the user explicitly requires otherwise; a per-screen lock is recorded in docs/platform-requirements.md, not here.",
      "items": { "enum": ["portrait", "landscape"] },
      "uniqueItems": true,
      "default": ["portrait", "landscape"]
    },
    "selectedAgents": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "template", "file", "reason"],
        "properties": {
          "id": { "type": "string", "pattern": "^project-[a-z0-9]+(-[a-z0-9]+)*$" },
          "template": { "type": "string" },
          "file": { "type": "string" },
          "reason": { "type": "string", "description": "Capability expression that selected this agent" },
          "scope": { "type": "string", "description": "Write scope for multi-instance agents" },
          "generatedAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "rejectedAgents": {
      "type": "array",
      "description": "Templates deliberately not generated, with the reason. Required for auditability.",
      "items": {
        "type": "object",
        "required": ["template", "reason"],
        "properties": {
          "template": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "generatedDocuments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "template", "status"],
        "properties": {
          "path": { "type": "string" },
          "template": { "type": "string" },
          "owner": { "type": "string", "description": "Agent id responsible for this document" },
          "status": {
            "type": "string",
            "enum": ["NOT_STARTED", "IN_PROGRESS", "COMPLETED", "NOT_APPLICABLE"]
          }
        }
      }
    },
    "skippedDocuments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "reason"],
        "properties": {
          "path": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "inputs": {
      "type": "object",
      "properties": {
        "descriptionFile": { "type": "string" },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "type", "analysisStatus"],
            "properties": {
              "file": { "type": "string" },
              "type": { "type": "string", "enum": ["pdf", "image", "markdown", "text", "spreadsheet", "document", "data", "other"] },
              "sha256": { "type": "string" },
              "analysisStatus": { "type": "string", "enum": ["ANALYSED", "PARTIAL", "UNREADABLE", "NOT_ANALYSED"] },
              "notes": { "type": "string" }
            }
          }
        }
      }
    },
    "currentPhase": {
      "type": "string",
      "enum": [
        "00-discover", "01-understand", "02-plan", "03-select-agents",
        "04-generate-structure", "05-implement", "06-integrate", "07-test",
        "08-playwright", "09-fix", "10-retest", "11-regression",
        "12-security", "13-performance", "14-release", "done"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["NOT_STARTED", "IN_PROGRESS", "BLOCKED", "READY_FOR_REVIEW", "COMPLETED", "FAILED"]
    },
    "releaseReadiness": {
      "type": "string",
      "enum": ["NOT_EVALUATED", "NOT_READY", "READY_WITH_CAVEATS", "READY"],
      "default": "NOT_EVALUATED"
    },
    "mcp": {
      "type": "object",
      "properties": {
        "playwright": {
          "type": "string",
          "enum": ["AVAILABLE", "UNAVAILABLE", "NOT_PROBED"],
          "default": "NOT_PROBED"
        },
        "lastProbedAt": { "type": "string", "format": "date-time" },
        "notes": { "type": "string" }
      }
    },
    "factoryVersion": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "definitions": {
    "stackArea": {
      "type": "object",
      "required": ["technology", "rationale"],
      "properties": {
        "technology": { "type": "string" },
        "version": { "type": "string" },
        "language": { "type": "string" },
        "framework": { "type": "string" },
        "packageManager": { "type": "string" },
        "rationale": { "type": "string" },
        "source": {
          "type": "string",
          "enum": ["USER_SPECIFIED", "REFERENCE_DOCUMENT", "EXISTING_CODEBASE", "FACTORY_DEFAULT"]
        }
      }
    }
  }
}
